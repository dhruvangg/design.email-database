{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": false,  
    "outDir": "./dist",
    "rootDir": "./",   
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["prisma/**/*.prisma", "./services", "./lib", "index.ts"],
  "exclude": [
    "node_modules"
  ]
}